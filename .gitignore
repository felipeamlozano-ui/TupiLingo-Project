# ==============================================================================
# TupiLingo — Root .gitignore (Enterprise Production & Development)
# Covers: Python / Django, Flutter / Dart, Node / Web, QA & Testing, IDEs & OS
# ==============================================================================

# ------------------------------------------------------------------------------
# 🐍 Python / Django Backend
# ------------------------------------------------------------------------------
__pycache__/
*.py[cod]
*$py.class
*.so
*.egg
*.egg-info/
dist/
build/
eggs/
.eggs/
parts/
var/
sdist/
develop-eggs/
.installed.cfg
share/python-wheels/
MANIFEST
*.manifest
*.spec

# Virtual Environments
venv/
env/
ENV/
env.bak/
venv.bak/
.venv/
backend/venv/
backend/env/

# Django Databases, Logs & Runtime State
*.sqlite3
*.sqlite3-journal
db.sqlite3
db.sqlite3-journal
backend/db.sqlite3
backend/db.sqlite3-journal
backend/rag_vectors.sqlite3
backend/rag_vectors.sqlite3-journal
local_settings.py
*.log
pip-log.txt
pip-delete-this-directory.txt

# Media, Uploads & Scraping
media/
backend/media/
backend/pdfs/
static_collected/
staticfiles/
.webassets-cache
.scrapy

# Testing & Type Checking (Python)
.tox/
.nox/
.coverage
.coverage.*
htmlcov/
nosetests.xml
coverage.xml
*.cover
*.py.cover
.hypothesis/
.pytest_cache/
backend/.pytest_cache/
.mypy_cache/
.dmypy.json
dmypy.json
.pyre/
.pytype/
.ipynb_checkpoints

# ------------------------------------------------------------------------------
# 📱 Flutter & Dart (frontend/tupi_lingo)
# ------------------------------------------------------------------------------
# Core Dart & Flutter Build Outputs
.dart_tool/
frontend/tupi_lingo/.dart_tool/
frontend/tupi_lingo/build/
.flutter-plugins
.flutter-plugins-dependencies
.packages
.pub-cache/
.pub/
frontend/tupi_lingo/.pub-cache/
frontend/tupi_lingo/.pub/

# Flutter Metadata & Symbols
frontend/tupi_lingo/.metadata
app.*.symbols
app.*.map.json

# Android Platform Builds & Secrets
**/android/.gradle/
**/android/local.properties
**/android/app/build/
**/android/captures/
**/android/.cxx/
**/android/app/src/main/assets/

# iOS Platform Builds & Ephemeral
**/ios/Pods/
**/ios/.symlinks/
**/ios/Flutter/ephemeral/
**/ios/Flutter/Generated.xcconfig
**/ios/Flutter/flutter_export_environment.sh
**/ios/Runner/GeneratedPluginRegistrant.*
**/ios/*.xcworkspace/
**/ios/*.mode1v3
**/ios/*.mode2v3
**/ios/*.moved-aside
**/ios/*.pbxuser
**/ios/*.perspectivev3

# Web, Windows & Desktop Ephemeral
**/web/build/
**/windows/flutter/ephemeral/
**/linux/flutter/ephemeral/
**/macos/Flutter/ephemeral/

# ------------------------------------------------------------------------------
# 🔐 Environment Variables & Secrets (CRITICAL ZERO-PII / ZERO-LEAK)
# ------------------------------------------------------------------------------
.env
.env.*
*.env
!.env.example
backend/.env
backend/.env.*
!backend/.env.example
frontend/tupi_lingo/.env
frontend/tupi_lingo/.env.*
!frontend/tupi_lingo/.env.example
.env.local
.env.development.local
.env.test.local
.env.production.local

# SSL & Encryption Keys
*.pem
*.key
*.p12
*.pfx
*.keystore
*.jks
google-services.json
GoogleService-Info.plist

