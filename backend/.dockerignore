# ============================================================
# .dockerignore — TupiLingo Backend
# ============================================================

# Ambiente virtual Python (NUNCA entra no container)
venv/
.venv/
env/

# Cache Python
__pycache__/
*.py[cod]
*.pyo
*.pyd
*.pyc
.Python

# Banco vetorial e progresso (dados de runtime — usar volumes)
vector_store.db
ingest_progress.json
worker.log
chroma_db/

# Logs
*.log
logs/

# Arquivos de desenvolvimento e IDE
.env
.env.*
!.env.example
*.env
.vscode/
.idea/
*.swp
*.swo
.DS_Store

# Git
.git/
.gitignore

# Testes e coverage
.coverage
htmlcov/
.pytest_cache/
coverage.xml

# Distribuição Python
dist/
build/
*.egg-info/

# Arquivos de mídia e PDFs (servidos via volumes)
media/
pdfs/
staticfiles/

# Docker (evita recursão)
docker-compose*.yml
# docker/ (removido para permitir COPY de arquivos como conf e entrypoints)

# Node (caso exista frontend)
node_modules/

# Documentação
*.md
README*
