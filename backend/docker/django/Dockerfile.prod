# syntax=docker/dockerfile:1.7
# ==============================================================================
# Fase 1: Builder (Instalação de dependências com uv)
# ==============================================================================
FROM python:3.13-slim-bookworm AS builder

ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    UV_COMPILE_BYTECODE=1 \
    UV_LINK_MODE=copy

# Instalar o uv
COPY --from=ghcr.io/astral-sh/uv:latest /uv /uvx /bin/

WORKDIR /app

# Instalar pacotes de compilação necessários
RUN apt-get update && apt-get install -y --no-install-recommends \
    gcc \
    libpq-dev \
    && rm -rf /var/lib/apt/lists/*

COPY requirements.txt .

# Instalar dependências de produção (excluindo debug/test)
RUN --mount=type=cache,target=/root/.cache/uv \
    uv pip install --system --no-cache-dir -r requirements.txt

# ==============================================================================
# Fase 2: Runtime (Imagem Final de Produção - Hardened & Rootless)
# ==============================================================================
FROM python:3.13-slim-bookworm

ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    DJANGO_SETTINGS_MODULE="config.settings.production" \
    PORT=8000

# Adicionar usuário não-root (Hardening)
RUN groupadd -r django && useradd -r -g django -s /sbin/nologin -c "Django User" django

# Instalar apenas dependências estritamente necessárias em runtime
RUN apt-get update && apt-get install -y --no-install-recommends \
    libpq-dev \
    tesseract-ocr \
    tesseract-ocr-por \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

# Copiar libs da fase builder
COPY --from=builder --link /usr/local/lib/python3.13/site-packages /usr/local/lib/python3.13/site-packages
COPY --from=builder --link /usr/local/bin /usr/local/bin

# Copiar código fonte
COPY --link --chown=django:django . .

# Copiar script de entrypoint e dar permissão
COPY --link --chown=django:django docker/django/entrypoint.sh /entrypoint.sh
RUN chmod +x /entrypoint.sh

# Trocar para usuário não-root
USER django

# Expor porta e executar entrypoint
EXPOSE 8000
ENTRYPOINT ["/entrypoint.sh"]

# Usar gunicorn (production WSGI server) em vez de runserver
CMD ["gunicorn", "--bind", "0.0.0.0:8000", "--workers", "3", "config.wsgi:application"]
